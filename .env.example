# Application
NUXT_PUBLIC_APP_NAME=PetYar
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_APP_LOCALE=fa-IR

# Session (nuxt-auth-utils) — generate a long random secret
NUXT_SESSION_PASSWORD=change-me-to-a-32-character-minimum-secret

# PostgreSQL
DATABASE_URL=postgres://petyar:petyar@localhost:5432/petyar
NUXT_DATABASE_URL=postgres://petyar:petyar@localhost:5432/petyar
# Optional dedicated DB for `npm run test:integration` — never production
TEST_DATABASE_URL=postgres://petyar:petyar@localhost:5432/petyar_test

# Object storage (local adapter by default; switch to minio in later phases)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/local
# MinIO (unused until STORAGE_DRIVER=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=petyar

# Payments (Zarinpal). Without ZARINPAL_MERCHANT_ID, checkout stays unavailable — never fakes PAID.
PAYMENT_DRIVER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
PAYMENT_PLATFORM_FEE_BPS=1000

# Logging
LOG_LEVEL=info
